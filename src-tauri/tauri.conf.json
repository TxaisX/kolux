{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kolux RS",
  "version": "0.1.0",
  "identifier": "com.txaisxiong.kolux-rs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kolux RS",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://github.com https://avatars.githubusercontent.com http://kolux-artifact.localhost kolux-artifact:; media-src http://kolux-artifact.localhost kolux-artifact:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://kolux-artifact.localhost kolux-artifact:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
