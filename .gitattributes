# CLI-006: cmd misreads labels in a batch file saved with bare LF line ends.
*.cmd text eol=crlf
# T-152-c: bash misreads a script saved with CRLF line ends (scripts/evidence/proof.sh).
*.sh text eol=lf
# Council ruling 2026-10-14: lane patches apply byte-exact; never convert their line ends.
*.patch -text
# T-603 (DT-C57): the editor fixture for a file that mixes CRLF and LF lines keeps its exact bytes.
src/editor/__fixtures__/* -text
# MERGE 117/118: an autocrlf checkout wrote STATE-history.md with CRLF and the merge kept both copies.
*.md text eol=lf
# Docs builder: scripts/docs/build.mjs writes LF, and `--check` compares bytes, so an autocrlf
# checkout with CRLF would report every generated page as stale forever.
docs/**/*.html text eol=lf
# The architecture diagram is embedded in the HTML infographic; keep its line ends stable too.
docs/**/*.svg text eol=lf
# T-700 (DT-C136): the PDF viewer files copied from pdfjs-dist keep their exact bytes, so the copy check
# compares like with like on an autocrlf checkout.
public/pdfjs/** -text
